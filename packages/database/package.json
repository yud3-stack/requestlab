{
  "name": "@requestlab/database",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:validate": "node scripts/check-direct-url.mjs && prisma validate",
    "db:generate": "node scripts/check-direct-url.mjs && prisma generate",
    "db:migrate": "node scripts/check-direct-url.mjs && prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "prisma": "^6.15.0",
    "tsx": "^4.20.5"
  }
}
